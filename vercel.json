{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/js/(.*)", "dest": "api/index.py" },
    { "src": "/css/(.*)", "dest": "api/index.py" },
    { "src": "/favicon.ico", "dest": "api/index.py" },
    { "src": "/login", "dest": "api/index.py" },
    { "src": "/dashboard", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
